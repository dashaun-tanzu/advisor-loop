<?xml version="1.0" encoding="UTF-8"?>
<!--
  The console belongs to ActivityReporter, which writes Org/Repo - activity - status straight to
  System.out. There is deliberately no console appender here, so nothing can interleave with that
  table. Everything diagnostic goes to the log file instead, which is where you look when an
  activity reports "fail" and you need the git/gh/advisor stderr behind it.
-->
<configuration>

    <property name="LOG_FILE" value="${ADVISOR_LOOP_LOG:-.workspace/advisor-loop.log}"/>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_FILE}</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{32} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="dev.dashaun.advisorloop" level="DEBUG"/>

    <root level="WARN">
        <appender-ref ref="FILE"/>
    </root>

</configuration>
